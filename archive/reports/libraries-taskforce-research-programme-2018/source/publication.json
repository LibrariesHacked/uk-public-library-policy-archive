ms.gov.uk","assets":[{"asset_manager_id":"5b32138440f0b67f82630a1d","filename":"180626_Libraries_Taskforce_completed_research.csv"}],"attachment_type":"file","command_paper_number":"","content_type":"text/csv","file_size":100469,"filename":"180626_Libraries_Taskforce_completed_research.csv","hoc_paper_number":"","id":"2779230","isbn":"","title":"Completed research in Research Overview","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/5b32138440f0b67f82630a1d/180626_Libraries_Taskforce_completed_research.csv"},{"accessible":false,"alternative_format_contact_email":"enquiries@dcms.gov.uk","assets":[{"asset_manager_id":"5b239692e5274a18eb1ee438","filename":"180615_Libraries_Taskforce_Ongoing_research.csv"}],"attachment_type":"file","command_paper_number":"","content_type":"text/csv","file_size":41772,"filename":"180615_Libraries_Taskforce_Ongoing_research.csv","hoc_paper_number":"","id":"2779231","isbn":"","title":"Ongoing research in Research Overview","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/5b239692e5274a18eb1ee438/180615_Libraries_Taskforce_Ongoing_research.csv"},{"accessible":false,"alternative_format_contact_email":"enquiries@dcms.gov.uk","assets":[{"asset_manager_id":"5acf614740f0b617dca7120f","filename":"180412_Libraries_Taskforce__planned_research.csv"}],"attachment_type":"file","command_paper_number":"","content_type":"text/csv","file_size":29358,"filename":"180412_Libraries_Taskforce__planned_research.csv","hoc_paper_number":"","id":"2779232","isbn":"","title":"Planned research in Research Overview","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/5acf614740f0b617dca7120f/180412_Libraries_Taskforce__planned_research.csv"}],"body":"<div class=\"govspeak\"><p><a href=\"https://www.gov.uk/government/publications/libraries-deliver-ambition-for-public-libraries-in-england-2016-to-2021\">Libraries Deliver: Ambition for Public Libraries in England</a> talks about ensuring library service design and delivery is informed by evidence and data. One key source of evidence is from research, and that’s why we have Action 4 in the <a href=\"https://www.gov.uk/government/uploads/system/uploads/attachment_data/file/603108/Ambition_Action_Plan_December_2016.pdf\">Ambition Action Plan</a>. To:</p>\n\n<blockquote>\n  <p class=\"last-child\">Identify and commission any further research work needed to measure the 7 Outcomes to be used as a shared evidence base by all, connecting to other research frameworks or other sectors where relevant.</p>\n</blockquote>\n\n<h3 id=\"research-programme\">Research programme</h3>\n\n<p>The spreadsheet ‘Libraries Taskforce - research overview’ provides an initial overview of libraries-related research which is:</p>\n\n<ul>\n  <li>completed</li>\n  <li>ongoing</li>\n  <li>planned (meaning research that has not yet begun but which is committed to being delivered: so the specification for the research has been produced, funding has been secured and (broad) timelines agreed)</li>\n</ul>\n\n<p>It also contains information on reports which form part of the policy landscape for public libraries in England and internationally. Please read the ‘Instructions’ csv for more information.</p>\n\n<p>The Libraries Taskforce is keen to fill in the gaps on the research listed, plus add in any other relevant research. If you have something to add, or you’ve spotted a mistake, please use this <a rel=\"external\" href=\"https://docs.google.com/forms/d/e/1FAIpQLSc4rUXCQd1Tv7u3NqOpa-Pex2SAGJ6ooZ4EO258-ku8bly85Q/viewform?usp=sf_link\">form</a> to provide the Taskforce with the information or email <a href=\"mailto:librariestaskforce@culture.gov.uk\">librariestaskforce@culture.gov.uk</a>. The spreadsheet will then be updated accordingly.</p>\n\n<p>If you have problems opening any of the items linked on this page, please contact us via the email above.</p>\n\n<h3 id=\"future-research-priorities\">Future research priorities</h3>\n\n<p>The Libraries Taskforce: future research priorities page (above) shows what future research is needed and how this was created through a sector led prioritisation exercise.</p>\n</div>","change_history":[{"note":"Completed research updated","public_timestamp":"2018-07-02T13:12:36Z"},{"note":"Completed and ongoing research sheets updated","public_timestamp":"2018-06-15T10:41:11Z"},{"note":"Completed research sheet updated","public_timestamp":"2018-06-08T10:58:37Z"},{"note":"Research overview updated","public_timestamp":"2018-04-12T14:14:40Z"},{"note":"Libraries Taskforce: future research priorities added","public_timestamp":"2017-08-17T08:59:26Z"},{"note":"Monthly update of attached spreadsheet entitled research overview","public_timestamp":"2017-08-07T10:43:33Z"},{"note":"Research spreadsheet updated","public_timestamp":"2017-07-03T13:38:53Z"},{"note":"First published.","public_timestamp":"2017-04-03T15:21:00Z"}],"document_type_label":"Corporate report","documents":["<section data-module=\"ga4-link-tracker\" class=\"gem-c-attachment govuk-!-margin-bottom-6\">\n  <div class=\"gem-c-attachment__thumbnail govuk-!-display-none-print\">\n    <a class=\"govuk-link\" target=\"_self\" tabindex=\"-1\" aria-hidden=\"true\" data-ga4-link=\"{&quot;event_name&quot;:&quot;navigation&quot;,&quot;type&quot;:&quot;attachment&quot;}\" href=\"/government/publications/libraries-taskforce-research-programme/libraries-taskforce-future-research-priorities\">\n        <svg class=\"gem-c-attachment__thumbnail-image gem-c-attachment__thumbnail-image--html\" version=\"1.1\" viewBox=\"0 0 99 140\" width=\"99\" height=\"140\" aria-hidden=\"true\">\n  <path d=\"M30,95h57v9H30V95z M30,77v9h39v-9H30z M30,122h48v-9H30V122z M12,68h9v-9h-9V68z M12,104h9v-9h-9V104z M12,86h9v-9h-9V86z M12,122h9v-9h-9V122z M87,12v27H12V12H87z M33,1