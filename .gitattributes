# Preserved source files must never be altered by Git line-ending conversion.
# A single changed byte would break the SHA-256 fixity recorded in provenance.yaml.
*.pdf   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.tif   binary
*.tiff  binary
*.gif   binary

# Plain-text archival records use LF line endings in the repository.
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.cff   text eol=lf
*.py    text eol=lf
*.txt   text eol=lf

